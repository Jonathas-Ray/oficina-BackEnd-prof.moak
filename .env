# ========== DOCKER HOST PORTS ==========
# Porta do MongoDB exposta no host (opcional, pode manter fixa)
MONGO_HOST_PORT=27017

# Porta do Backend NestJS exposta no host
BACKEND_HOST_PORT=3000

# ========== MONGODB LOCAL (DOCKER) ==========
MONGO_DB_NAME=app_db
MONGO_USER=root
MONGO_PASSWORD=root1234
MONGO_CONTAINER_PORT=27017
# URI interna para o backend se conectar (dentro da rede Docker)
# MONGO_URI=mongodb://${MONGO_USER}:${MONGO_PASSWORD}@mongodb:${MONGO_CONTAINER_PORT}/${MONGO_DB_NAME}?authSource=admin